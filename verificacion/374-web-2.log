        "tiempo": 9793.730000019073,
        "tomado": false,
        "hasFocus": true,
        "estado": {
          "abierto": false,
          "alma": true,
          "botones": [
            {
              "habilitado": true,
              "nombre": "",
              "texto": "Volver",
