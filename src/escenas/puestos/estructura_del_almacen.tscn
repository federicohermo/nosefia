[node name="almacen" parent="."]
layers = 3
gi_lightmap_texel_scale = 4.0
editor_description = "Más resolución en el horneado de paredes y pisos para evitar que el filtrado mezcle la luz del salón en la unión con el depósito. La capa visual 2 bloquea las luces de las heladeras sin que sus estantes internos oscurezcan los productos."

