[gd_scene format=3]

[node name="SondasDeLaHeladera" type="Node3D"]
metadata/ganancia_de_las_sondas = 6.0
editor_description = "La mercadería de la heladera toma la luz de estas sondas, y una sonda guarda el rebote, no la luz directa de `LuzInterior`. La ganancia (`metadata/ganancia_de_las_sondas`, la aplica el horneado) devuelve a los productos la luz que le dan al estante. Hay una sonda en cada hueco entre estantes y dos planos de profundidad: el tetraedro de cada producto queda adentro de la heladera."

