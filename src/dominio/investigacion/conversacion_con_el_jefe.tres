[gd_resource type="Resource" script_class="Conversacion" format=3]

[ext_resource type="Script" path="res://src/dominio/investigacion/mensaje.gd" id="mensaje"]
[ext_resource type="Script" path="res://src/dominio/investigacion/conversacion.gd" id="conversacion"]
[ext_resource type="Texture2D" path="res://assets/ui/manada/enrique.png" id="enrique"]
[ext_resource type="Texture2D" path="res://assets/ui/manada/fotos/intro-04.png" id="foto04"]
[ext_resource type="Texture2D" path="res://assets/ui/manada/fotos/intro-06.png" id="foto06"]
[ext_resource type="Texture2D" path="res://assets/ui/manada/fotos/intro-07.png" id="foto07"]
[ext_resource type="Texture2D" path="res://assets/ui/manada/fotos/intro-08.png" id="foto08"]
[ext_resource type="Texture2D" path="res://assets/ui/manada/fotos/intro-09.png" id="foto09"]
[ext_resource type="Texture2D" path="res://assets/ui/manada/fotos/intro-11.png" id="foto11"]
[ext_resource type="Texture2D" path="res://assets/ui/manada/fotos/intro-13.png" id="foto13"]

[sub_resource type="Resource" id="Intro01"]
script = ExtResource("mensaje")
de_quien = "Enrique Peldaño"
texto = "¿Cómo andás, pibe? Llegó el momento de lucirte. Tu período de prueba va a ser de solo cinco jornadas. ¿Quién pudiera, no?\n\nDe todos modos, acordate de que el primer mes no es pago, porque lo tomamos como capacitación. ;)"

[sub_resource type="Resource" id="Foto02"]
script = ExtResource("mensaje")
de_quien = "Enrique Peldaño"
foto = ExtResource("foto04")

[sub_resource type="Resource" id="Intro02"]
script = ExtResource("mensaje")
de_quien = "Enrique Peldaño"
texto = "Bueno, como ya te comenté, [b]la jornada es de 20:00 a 08:00. [/b]Debería sobrarte el tiempo para cumplir con las [b]tareas [/b]que te voy a dejar.\n\nCualquier cosa, siempre van a quedar [b]anotadas en el corcho[/b], atrás del mostrador. Te las resumo:"

[sub_resource type="Resource" id="Foto03"]
script = ExtResource("mensaje")
de_quien = "Enrique Peldaño"
foto = ExtResource("foto06")

[sub_resource type="Resource" id="Intro03"]
script = ExtResource("mensaje")
de_quien = "Enrique Peldaño"
texto = "Primero, y lo más importante: [b]ATENDER A LOS CLIENTES[/b]. A esa hora, la entrada principal queda cerrada, así que vas a tener que [b]hablarles y entregarles los productos por la ventanilla[/b]. ¡Y no te olvides de [b]darles un ticket [/b]de recibo!"

[sub_resource type="Resource" id="Foto04"]
script = ExtResource("mensaje")
de_quien = "Enrique Peldaño"
foto = ExtResource("foto07")

[sub_resource type="Resource" id="Intro04"]
script = ExtResource("mensaje")
de_quien = "Enrique Peldaño"
texto = "Para [b]generar un ticket[/b], tenés que pasar todos los productos por el [b]lector del mostrador[/b] y darle al botón “IMPRIMIR” en el [b]programa de la caja registradora[/b]. Nada muy complejo."

[sub_resource type="Resource" id="Intro05"]
script = ExtResource("mensaje")
de_quien = "Enrique Peldaño"
texto = "Conozco a varios que hasta son capaces de dejar los productos e irse si no les das su recibo. Eso NO puede pasar.\n\nMi estación de servicio es el único local del pueblo que queda abierto las 24 horas, así que los compradores nocturnos dependen de nosotros. Atenderlos mal es faltarle el respeto a nuestros vecinos, así que ojito."

[sub_resource type="Resource" id="Foto06"]
script = ExtResource("mensaje")
de_quien = "Enrique Peldaño"
foto = ExtResource("foto08")

[sub_resource type="Resource" id="Intro06"]
script = ExtResource("mensaje")
de_quien = "Enrique Peldaño"
texto = "En segundo lugar, [b]ANOTAR LOS PRODUCTOS VENDIDOS [/b]durante la noche en la [b]computadora[/b]. Bastante simple."

[sub_resource type="Resource" id="Foto07"]
script = ExtResource("mensaje")
de_quien = "Enrique Peldaño"
foto = ExtResource("foto09")

[sub_resource type="Resource" id="Intro07"]
script = ExtResource("mensaje")
de_quien = "Enrique Peldaño"
texto = "Tercero, hacer la [b]REPOSICIÓN[/b]. Revisá bien todas las [b]góndolas [/b]y reponé los ítems que falten con los de las [b]cajas del depósito[/b]."

[sub_resource type="Resource" id="Intro08"]
script = ExtResource("mensaje")
de_quien = "Enrique Peldaño"
texto = "No quiero ver ni un solo hueco vacío.\n\nUn único producto ausente en la mañana puede hacer la diferencia entre un local de excelencia y uno mediocre. No podemos dar la impresión de que estamos cortos de stock."

[sub_resource type="Resource" id="Foto09"]
script = ExtResource("mensaje")
de_quien = "Enrique Peldaño"
foto = ExtResource("foto11")

[sub_resource type="Resource" id="Intro09"]
script = ExtResource("mensaje")
de_quien = "Enrique Peldaño"
texto = "Cuarto, pero no menor, [b]LIMPIAR[/b]. Vas a encontrar los [b]productos de limpieza en el baño[/b], además de algunas [b]notitas [/b]explicando cómo usarlos. No deberías tener problemas con eso."

[sub_resource type="Resource" id="Intro10"]
script = ExtResource("mensaje")
de_quien = "Enrique Peldaño"
texto = "Además de los quehaceres rutinarios, siempre queda alguna cosita por hacer. Por eso, no te sorprendas si ves una quinta tarea diferente cada noche. Tranqui, que te voy a dejar instrucciones por mensaje."

[sub_resource type="Resource" id="Foto11"]
script = ExtResource("mensaje")
de_quien = "Enrique Peldaño"
foto = ExtResource("foto13")

[sub_resource type="Resource" id="Intro11"]
script = ExtResource("mensaje")
de_quien = "Enrique Peldaño"
texto = "Para esta noche, te pido [b]ORGANIZAR LAS CAJAS[/b] que dejó el proveedor. Acomodalas [b]en los estantes del depósito[/b] y que no quede ni una en el piso, ¿ok?"

[sub_resource type="Resource" id="Intro12"]
script = ExtResource("mensaje")
de_quien = "Enrique Peldaño"
texto = "Te voy a tener cortito con esos detalles. Para trabajar en una estación de servicio tan prestigiosa como esta, tenés que estar al nivel.\n\nMe parece que con eso cubrimos todo. No te olvides de dejar el local correctamente ordenado antes de irte. ¿Estamos?"

[resource]
script = ExtResource("conversacion")
nombre = "Enrique Peldaño"
imagen = ExtResource("enrique")
mensajes = Array[ExtResource("mensaje")]([SubResource("Intro01"), SubResource("Foto02"), SubResource("Intro02"), SubResource("Foto03"), SubResource("Intro03"), SubResource("Foto04"), SubResource("Intro04"), SubResource("Intro05"), SubResource("Foto06"), SubResource("Intro06"), SubResource("Foto07"), SubResource("Intro07"), SubResource("Intro08"), SubResource("Foto09"), SubResource("Intro09"), SubResource("Intro10"), SubResource("Foto11"), SubResource("Intro11"), SubResource("Intro12")])
