[sub_resource type="Resource" id="J2_TEXTO"]
script = ExtResource("mensaje")
identidad = "J2_CONTENEDOR_TEXTO"
jornada = 5
orden = 1
de_quien = "Enrique Peldaño"
texto = "Buen día, pibe. Hoy te pido que tires la basura de todos los tachos del local en el contenedor. Saludos"

