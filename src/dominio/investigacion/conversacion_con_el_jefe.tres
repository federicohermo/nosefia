[sub_resource type="Resource" id="Intro01"]
script = ExtResource("mensaje")
identidad = "J1_Intro01"
orden = 0
de_quien = "Enrique Peldaño"
texto = "¿Cómo andás, pibe? Llegó el momento de lucirte. Tu período de prueba va a ser de solo una semana. Y encima voy a dejar que te vayas temprano los primeros días si terminás el laburo rápido. ¿Quién pudiera, no?\n\nDe todos modos, acordate de que el primer mes no es pago, porque lo tomamos como capacitación. ;)"

[sub_resource type="Resource" id="FotoReloj"]
script = ExtResource("mensaje")
identidad = "J1_FotoReloj"
orden = 1
de_quien = "Enrique Peldaño"
foto = ExtResource("reloj")

[sub_resource type="Resource" id="Foto02"]
script = ExtResource("mensaje")
identidad = "J1_Foto02"
orden = 1
de_quien = "Enrique Peldaño"
foto = ExtResource("foto04")

[sub_resource type="Resource" id="Intro02"]
script = ExtResource("mensaje")
identidad = "J1_Intro02"
orden = 2
de_quien = "Enrique Peldaño"
texto = "Bueno, como ya te comenté en la entrevista, [b]la jornada es de 20 a 08. [/b]Debería sobrarte el tiempo para cumplir con las [b]tareas [/b]que te voy a dejar.\n\nCualquier cosa, siempre van a quedar [b]anotadas en el corcho[/b], atrás del mostrador."

[sub_resource type="Resource" id="Foto03"]
script = ExtResource("mensaje")
identidad = "J1_Foto03"
orden = 3
de_quien = "Enrique Peldaño"
foto = ExtResource("foto06")

[sub_resource type="Resource" id="Intro03"]
script = ExtResource("mensaje")
identidad = "J1_Intro03"
orden = 4
de_quien = "Enrique Peldaño"
texto = "Hoy es fundamental que aprendas lo más importante: [b]ATENDER A LOS CLIENTES[/b]. Durante el turno nocturno, la entrada principal queda cerrada, así que vas a tener que [b]hablarles y entregarles los productos por la ventanilla[/b].\n\n¡Y no te olvides de [b]darles un ticket [/b]de recibo!"

[sub_resource type="Resource" id="Foto04"]
script = ExtResource("mensaje")
identidad = "J1_Foto04"
orden = 5
de_quien = "Enrique Peldaño"
foto = ExtResource("foto07")

[sub_resource type="Resource" id="Intro04"]
script = ExtResource("mensaje")
identidad = "J1_Intro04"
orden = 6
de_quien = "Enrique Peldaño"
texto = "Para [b]generar un ticket[/b], tenés que pasar todos los productos por el [b]lector del mostrador[/b] y darle al botón “IMPRIMIR” en el [b]programa de la caja registradora[/b]. Nada muy complejo."

[sub_resource type="Resource" id="Intro05"]
script = ExtResource("mensaje")
identidad = "J1_Intro05"
orden = 7
de_quien = "Enrique Peldaño"
texto = "Conozco a varios que hasta son capaces de dejar los productos e irse si no les das su recibo. Eso NO puede pasar.\n\nMi estación de servicio es el único local del pueblo que queda abierto las 24 horas, así que los compradores nocturnos dependen de nosotros. Atenderlos mal es faltarle el respeto a nuestros vecinos, así que ojito."

[sub_resource type="Resource" id="Foto06"]
script = ExtResource("mensaje")
identidad = "J1_Foto06"
orden = 8
de_quien = "Enrique Peldaño"
foto = ExtResource("foto08")

[sub_resource type="Resource" id="Intro06"]
script = ExtResource("mensaje")
identidad = "J1_Intro06"
orden = 9
de_quien = "Enrique Peldaño"
texto = "Además de cumplir con la atención al cliente, tenés que [b]ANOTAR LOS PRODUCTOS VENDIDOS [/b]durante la noche en la [b]computadora[/b]. Bastante simple. El programa se explica solo.\n\nY también te voy a pedir que hagas la [b]REPOSICIÓN[/b], de los productos que saques de las [b]góndolas[/b] con los que hay en las [b]cajas del depósito[/b].\n\nA ver cómo te manejás con eso."

[sub_resource type="Resource" id="J2_Mensaje1_SinFallas"]
script = ExtResource("mensaje")
identidad = "J2_Mensaje1_SinFallas"
jornada = 2
orden = 9
de_quien = "Enrique Peldaño"
condicion = &"J2_SIN_FALLAS"
texto = "Muy bien. Veo que pudiste cumplir con tus tareas correctamente, así que te voy a sumar una más."

[sub_resource type="Resource" id="J2_Mensaje1_RegistroMal"]
script = ExtResource("mensaje")
identidad = "J2_Mensaje1_RegistroMal"
jornada = 2
orden = 9
de_quien = "Enrique Peldaño"
condicion = &"J2_REGISTRO_MAL"
texto = "Bueno, por lo visto, pudiste atender bien a todos los clientes, pero el registro de ventas no cuadra.

Vas a tener que prestar más atención, especialmente ahora que te voy a sumar una tarea más."

[sub_resource type="Resource" id="J2_Mensaje1_ReposicionMal"]
script = ExtResource("mensaje")
identidad = "J2_Mensaje1_ReposicionMal"
jornada = 2
orden = 9
de_quien = "Enrique Peldaño"
condicion = &"J2_REPOSICION_MAL"
texto = "Bueno, por lo visto, pudiste atender bien a todos los clientes y hacer el registro, pero quedaron algunos huecos vacíos en las góndolas.

Vas a tener que prestar más atención, especialmente ahora que te voy a sumar una tarea más."

[sub_resource type="Resource" id="J2_Mensaje1_UnClienteMal"]
script = ExtResource("mensaje")
identidad = "J2_Mensaje1_UnClienteMal"
jornada = 2
orden = 9
de_quien = "Enrique Peldaño"
condicion = &"J2_UN_CLIENTE_MAL"
texto = "Bueno, por lo visto, el registro de ventas cuadra bien, pero me enteré de que un cliente se fue insatisfecho ayer.

Voy a ser considerado con vos porque fue tu primer día, pero vas a tener que ponerte las pilas, especialmente ahora que te voy a sumar una tarea más."

[sub_resource type="Resource" id="J2_Mensaje1_UnClienteYReposicionMal"]
script = ExtResource("mensaje")
identidad = "J2_Mensaje1_UnClienteYReposicionMal"
jornada = 2
orden = 9
de_quien = "Enrique Peldaño"
condicion = &"J2_UN_CLIENTE_Y_REPOSICION_MAL"
texto = "Bueno, por lo visto, el registro de ventas cuadra bien, pero me enteré de que un cliente se fue insatisfecho ayer. Además, quedaron huecos vacíos en las góndolas.

Voy a ser considerado con vos porque fue tu primer día, pero vas a tener que ponerte las pilas, especialmente ahora que te voy a sumar una tarea más."

[sub_resource type="Resource" id="J2_Mensaje1_UnClienteYRegistroMal"]
script = ExtResource("mensaje")
identidad = "J2_Mensaje1_UnClienteYRegistroMal"
jornada = 2
orden = 9
de_quien = "Enrique Peldaño"
condicion = &"J2_UN_CLIENTE_Y_REGISTRO_MAL"
texto = "Me enteré de que un cliente se fue insatisfecho ayer. Y el registro de ventas no cuadra con lo que se vendió durante la noche.

Voy a ser considerado con vos porque fue tu primer día, pero vas a tener que ponerte las pilas, especialmente ahora que te voy a sumar una tarea más."

[sub_resource type="Resource" id="J2_Mensaje1_UnClienteYTodoMal"]
script = ExtResource("mensaje")
identidad = "J2_Mensaje1_UnClienteYTodoMal"
jornada = 2
orden = 9
de_quien = "Enrique Peldaño"
condicion = &"J2_UN_CLIENTE_Y_TODO_MAL"
texto = "Me enteré de que un cliente se fue insatisfecho ayer y el registro de ventas no cuadra con lo que se vendió durante la noche. Además, quedaron huecos vacíos en las góndolas.

Voy a ser considerado con vos porque fue tu primer día, pero vamos a tener problemas si no te ponés las pilas, especialmente ahora que te voy a sumar una tarea más."

[sub_resource type="Resource" id="J2_Mensaje1_NingunoEnCero"]
script = ExtResource("mensaje")
identidad = "J2_Mensaje1_NingunoEnCero"
jornada = 2
orden = 9
de_quien = "Enrique Peldaño"
condicion = &"J2_NINGUNO_EN_CERO"
texto = "Che, me enteré de que ayer pasaron dos clientes y no atendiste correctamente a ninguno de los dos. O sea, por culpa tuya no tuvimos ingresos en el turno nocturno.

Voy a ser considerado con vos porque fue tu primer día, pero vamos a tener problemas si no te ponés las pilas, especialmente ahora que te voy a sumar una tarea más."

[sub_resource type="Resource" id="J2_Mensaje1_NingunoEnCeroYReposicionMal"]
script = ExtResource("mensaje")
identidad = "J2_Mensaje1_NingunoEnCeroYReposicionMal"
jornada = 2
orden = 9
de_quien = "Enrique Peldaño"
condicion = &"J2_NINGUNO_EN_CERO_Y_REPOSICION_MAL"
texto = "Che, me enteré de que ayer pasaron dos clientes y no atendiste correctamente a ninguno de los dos. O sea, por culpa tuya no tuvimos ingresos en el turno nocturno.

Y además, quedaron huecos vacíos en las góndolas. ¿Para qué sacaste productos, si ni siquiera los vendiste?

Voy a ser considerado con vos porque fue tu primer día, pero vamos a tener problemas si no te ponés las pilas, especialmente ahora que te voy a sumar una tarea más."

[sub_resource type="Resource" id="J2_Mensaje1_NingunoAnotado"]
script = ExtResource("mensaje")
identidad = "J2_Mensaje1_NingunoAnotado"
jornada = 2
orden = 9
de_quien = "Enrique Peldaño"
condicion = &"J2_NINGUNO_ANOTADO"
texto = "Che, me enteré de que ayer pasaron dos clientes y no atendiste correctamente a ninguno de los dos. O sea, por culpa tuya no tuvimos ingresos en el turno nocturno.

Y encima anotaste en el registro productos que no se vendieron. ¿Me estás tomando el pelo?

Voy a ser considerado con vos porque fue tu primer día, pero vamos a tener problemas si no te ponés las pilas, especialmente ahora que te voy a sumar una tarea más."

[sub_resource type="Resource" id="J2_Mensaje1_NingunoAnotadoYReposicionMal"]
script = ExtResource("mensaje")
identidad = "J2_Mensaje1_NingunoAnotadoYReposicionMal"
jornada = 2
orden = 9
de_quien = "Enrique Peldaño"
condicion = &"J2_NINGUNO_ANOTADO_Y_REPOSICION_MAL"
texto = "Che, me enteré de que ayer pasaron dos clientes y no atendiste correctamente a ninguno de los dos. O sea, por culpa tuya no tuvimos ingresos en el turno nocturno.

Además, quedaron huecos vacíos en las góndolas. Y encima anotaste en el registro productos que no se vendieron. ¿Me estás tomando el pelo?

Voy a ser considerado con vos porque fue tu primer día, pero vamos a tener problemas si no te ponés las pilas, especialmente ahora que te voy a sumar una tarea más."

