[gd_resource type="Resource" script_class="Conversacion" format=3]

[ext_resource type="Script" path="res://src/dominio/investigacion/mensaje.gd" id="mensaje"]
[ext_resource type="Script" path="res://src/dominio/investigacion/conversacion.gd" id="conversacion"]
[ext_resource type="Texture2D" path="res://assets/ui/manada/enrique.png" id="enrique"]
[ext_resource type="Texture2D" path="res://assets/ui/manada/fotos/intro-04.png" id="foto04"]
[ext_resource type="Texture2D" path="res://assets/ui/manada/fotos/intro-06.png" id="foto06"]
[ext_resource type="Texture2D" path="res://assets/ui/manada/fotos/intro-07.png" id="foto07"]
[ext_resource type="Texture2D" path="res://assets/ui/manada/fotos/intro-08.png" id="foto08"]
[ext_resource type="Texture2D" path="res://assets/ui/manada/fotos/intro-09.png" id="foto09"]
[ext_resource type="Texture2D" path="res://assets/ui/manada/fotos/intro-11.png" id="foto11"]
[ext_resource type="Texture2D" path="res://assets/ui/manada/fotos/intro-13.png" id="foto13"]

[sub_resource type="Resource" id="Intro01"]
script = ExtResource("mensaje")
de_quien = "Enrique Peldaño"
texto = "¿Cómo andás, pibe? Llegó el momento de lucirte.\nTu período de prueba va a ser de cinco días.\n¿Quién pudiera, no?"

[sub_resource type="Resource" id="Intro02"]
script = ExtResource("mensaje")
de_quien = "Enrique Peldaño"
texto = "Acordate que el primer mes no es pago, lo tomamos como capacitación."

[sub_resource type="Resource" id="Intro03"]
script = ExtResource("mensaje")
de_quien = "Enrique Peldaño"
texto = "La jornada arranca a las [b]8PM[/b] y termina a las [b]8AM[/b].\nDebería sobrarte el tiempo para cumplir con las tareas que te voy a dejar."

[sub_resource type="Resource" id="Foto04"]
script = ExtResource("mensaje")
de_quien = "Enrique Peldaño"
foto = ExtResource("foto04")

[sub_resource type="Resource" id="Intro04"]
script = ExtResource("mensaje")
de_quien = "Enrique Peldaño"
texto = "Siempre van a quedar anotadas en el corcho, atrás del mostrador."

[sub_resource type="Resource" id="Intro05"]
script = ExtResource("mensaje")
de_quien = "Enrique Peldaño"
texto = "Primero, y lo más importante: [b]atender a los clientes[/b]. Mi estación de servicio es el único local del pueblo que queda abierto las 24 horas, así que los compradores nocturnos dependen de nosotros. Atenderlos mal es faltarle el respeto a nuestros vecinos, así que ojito."

[sub_resource type="Resource" id="Foto06"]
script = ExtResource("mensaje")
de_quien = "Enrique Peldaño"
foto = ExtResource("foto06")

[sub_resource type="Resource" id="Intro06"]
script = ExtResource("mensaje")
de_quien = "Enrique Peldaño"
texto = "A esa hora, la entrada principal queda cerrada, así que se van a asomar por la ventanilla. Atendé los pedidos y no te olvides de darles un ticket de recibo. Conozco a varios que hasta son capaces de dejar los productos e irse si no se los das. Eso NO puede pasar."

[sub_resource type="Resource" id="Foto07"]
script = ExtResource("mensaje")
de_quien = "Enrique Peldaño"
foto = ExtResource("foto07")

[sub_resource type="Resource" id="Intro07"]
script = ExtResource("mensaje")
de_quien = "Enrique Peldaño"
texto = "Para generar un ticket, tenés que pasar todos los productos por el lector del mostrador y darle al botón “imprimir” en el programa de la caja registradora. Nada muy complejo."

[sub_resource type="Resource" id="Foto08"]
script = ExtResource("mensaje")
de_quien = "Enrique Peldaño"
foto = ExtResource("foto08")

[sub_resource type="Resource" id="Intro08"]
script = ExtResource("mensaje")
de_quien = "Enrique Peldaño"
texto = "En segundo lugar, [b]anotar los productos vendidos [/b]durante la noche en la computadora. Bastante simple."

[sub_resource type="Resource" id="Foto09"]
script = ExtResource("mensaje")
de_quien = "Enrique Peldaño"
foto = ExtResource("foto09")

[sub_resource type="Resource" id="Intro09"]
script = ExtResource("mensaje")
de_quien = "Enrique Peldaño"
texto = "Tercero, [b]reponer los productos[/b]. Revisá bien todas las góndolas y reponé los ítems que falten con los de las cajas del depósito. No quiero ver ni un solo hueco vacío."

[sub_resource type="Resource" id="Intro10"]
script = ExtResource("mensaje")
de_quien = "Enrique Peldaño"
texto = "Un único producto ausente en la mañana puede hacer la diferencia entre un local de excelencia y uno mediocre. No podemos dar la impresión de que estamos cortos de stock."

[sub_resource type="Resource" id="Foto11"]
script = ExtResource("mensaje")
de_quien = "Enrique Peldaño"
foto = ExtResource("foto11")

[sub_resource type="Resource" id="Intro11"]
script = ExtResource("mensaje")
de_quien = "Enrique Peldaño"
texto = "Cuarto, pero no menor, [b]limpiar[/b]. Vas a encontrar los productos de limpieza en el baño, además de algunas notitas explicando cómo usarlos. No deberías tener problemas con eso."

[sub_resource type="Resource" id="Intro12"]
script = ExtResource("mensaje")
de_quien = "Enrique Peldaño"
texto = "Además de los quehaceres rutinarios, siempre queda alguna cosita por hacer. Por eso, no te sorprendas si ves una quinta tarea diferente cada noche. Tranqui, que te voy a dejar instrucciones por este medio."

[sub_resource type="Resource" id="Foto13"]
script = ExtResource("mensaje")
de_quien = "Enrique Peldaño"
foto = ExtResource("foto13")

[sub_resource type="Resource" id="Intro13"]
script = ExtResource("mensaje")
de_quien = "Enrique Peldaño"
texto = "Para esta noche, te pido que [b]organices las cajas[/b] que dejó el proveedor en el depósito. Acomodalas en los estantes y que no quede ni una en el piso, entendido? Te voy a tener cortito con esos detalles. Para trabajar en una estación de servicio tan prestigiosa como esta, tenés que estar al nivel."

[sub_resource type="Resource" id="Intro14"]
script = ExtResource("mensaje")
de_quien = "Enrique Peldaño"
texto = "Me parece que con eso estaríamos. No te olvides de dejar el local correctamente ordenado antes de irte. Estamos?"

[resource]
script = ExtResource("conversacion")
nombre = "Enrique Peldaño"
imagen = ExtResource("enrique")
mensajes = Array[ExtResource("mensaje")]([SubResource("Intro01"), SubResource("Intro02"), SubResource("Intro03"), SubResource("Foto04"), SubResource("Intro04"), SubResource("Intro05"), SubResource("Foto06"), SubResource("Intro06"), SubResource("Foto07"), SubResource("Intro07"), SubResource("Foto08"), SubResource("Intro08"), SubResource("Foto09"), SubResource("Intro09"), SubResource("Intro10"), SubResource("Foto11"), SubResource("Intro11"), SubResource("Intro12"), SubResource("Foto13"), SubResource("Intro13"), SubResource("Intro14")])
