+func _b306_carga(
+	jugador: CharacterBody3D,
+	unidad: ObjetoAgarrable,
+	centro: Vector3,
+	previsto: Vector3,
+	indice: int,
+	etapa: String
+) -> void:
+	var forma: CollisionShape3D = unidad.get_node("Forma")
+	var ojo: Transform3D = jugador.call("mira")
+	var rayo := PhysicsRayQueryParameters3D.create(
+		ojo.origin, ojo.origin - ojo.basis.z * ReglasDelJugador.ALCANCE_DE_LA_MIRA
+	)
+	rayo.exclude = [jugador.get_rid(), unidad.get_rid()]
+	var golpe := jugador.get_world_3d().direct_space_state.intersect_ray(rayo)
+	var mira: Dictionary = {}
+	if not golpe.is_empty():
+		mira = {
+			"collider": str(golpe.collider.get_path()),
+			"position": str(golpe.position),
+			"normal": str(golpe.normal)
+		}
+	print(
+		"B306CARGA ",
+		JSON.stringify(
+			{
+				"indice": indice,
+				"etapa": etapa,
+				"id": str(unidad.datos.id),
+				"previsto": str(previsto),
+				"real": str(unidad.global_position),
+				"relativo": str(unidad.global_position - centro),
+				"jugador": str(jugador.global_position),
+				"ojo": str(ojo.origin),
+				"forma": forma.shape.get_class(),
+				"limites_forma": str(forma.shape.get_debug_mesh().get_aabb()),
+				"basis": str(unidad.global_basis),
+				"layer": unidad.collision_layer,
+				"mask": unidad.collision_mask,
+				"velocity": str(unidad.linear_velocity),
+				"angular_velocity": str(unidad.angular_velocity),
+				"derecho": unidad.datos.se_apoya_derecho,
+				"mira": mira
+			}
+		)
+	)
