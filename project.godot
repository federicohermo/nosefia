[layer_names]

3d_physics/layer_4="contorno_de_los_muebles"
3d_physics/layer_5="hueco_de_la_ventanilla"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

renderer/rendering_method="gl_compatibility"
reflections/reflection_atlas/reflection_count.web=5
web/area_lights_need_parallel_link=true
