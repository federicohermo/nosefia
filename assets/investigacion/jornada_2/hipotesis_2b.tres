[gd_resource type="Resource" script_class="Hipotesis" format=3]

[ext_resource type="Script" path="res://src/dominio/investigacion/hipotesis.gd" id="hipotesis"]

[resource]
script = ExtResource("hipotesis")
identidad = "2B"
jornada = 4
titulo = "CIGARRILLO EN EL DEPÓSITO"
texto = "¿Puede ser que alguien se esté metiendo sin que nos demos cuenta? Debería examinar bien las formas de ingreso al local…\n\nADVERTENCIA: Este camino aún no está listo. Si lo elegís, no te van a aparecer más pistas y tu investigación va a quedar incompleta. Recomendamos elegir la otra pista o reiniciar la jornada si no la encontraste."
exigencias = PackedStringArray("2B")
camino = PackedStringArray("5C", "5D")
