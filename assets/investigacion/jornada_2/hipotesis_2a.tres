[gd_resource type="Resource" script_class="Hipotesis" format=3]

[ext_resource type="Script" path="res://src/dominio/investigacion/hipotesis.gd" id="hipotesis"]

[resource]
script = ExtResource("hipotesis")
identidad = "2A"
jornada = 4
titulo = "SIEMPRE FALTAN COSAS"
texto = "Siento que esto no fue casualidad. Ya tuve malas experiencias con jefes y colegas que no hacían bien su trabajo o que directamente me querían serruchar el piso. Si esto va a ser frecuente, tengo que empezar a prestar más atención a las dinámicas internas del local."
exigencias = PackedStringArray("2A")
camino = PackedStringArray("5A", "5B")
