[gd_resource type="Resource" script_class="Hipotesis" format=3]

[ext_resource type="Script" path="res://src/dominio/investigacion/hipotesis.gd" id="hipotesis"]

[resource]
script = ExtResource("hipotesis")
identidad = "2A"
jornada = 2
titulo = "SIEMPRE FALTAN COSAS"
texto = "No me sorprendería tener un jefe inútil. Pero también, ¿no es responsabilidad de Yasmín avisar si faltan cosas esenciales? Si esto va a ser frecuente, tengo que empezar a prestar más atención a las dinámicas internas del local."
exigencias = PackedStringArray("2A")
