[gd_resource type="Resource" script_class="DialogosDeCompradores" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/dominio/almacen/dialogos_de_compradores.gd" id="1"]

[resource]
script = ExtResource("1")
tin = PackedStringArray("\"Hola... ¿Cómo andás?... Mmm, eee... Me parece que hoy me toca cocinar [color=#e4f850]huevos con arvejas[/color]... Pará, pará... Hoy como en lo de mi vieja, entonces..¿No tenés un paquete de [b][color=#e4f850]Marolinis[/color][/b] y una [b][color=#e4f850]Coracola[/color][/b] , de onda?...\"", "Gracias, che... uh, me olvidé, me quedé sin [b][color=#e4f850]Malbardo[/color][/b].. ¿de casualidad no te sobra un puchito?...", "Es un chiste, hermano... dale, pasame una caja... ¿cuánto sería todo?...")
tia = PackedStringArray("Hola! Quiero una caja de cereal [b][color=#cbdc48]Zucarachas[/color][/b] y una caja de galletitas [b][color=#e4f850]Pepito[/color][/b], por favor.")
despedida_tin = PackedStringArray("Gracias, che... sos lo más, en serio...")
despedida_tia = PackedStringArray("Gracias, tenía mucha hambre.", "Me presento: soy el Sr.T ¡mucho gusto! Soy investigador criminal. La última vez que estuve por acá ocurrió una tragedia. ¿No te enteraste lo que pasó con el empleado anterior?", "Con mi equipo de investigación seguimos analizando los movimientos de Enrique Peldaño dueño de esta estación de servicio", "En fin…. voy a disfrutar de las zucarachas. Te dejo mi número de teléfono por si acaso..\n11 ****-**** ¡Anotalo! Hasta pronto!!")
recordatorio_tin = "Quiero una caja de fideos [b][color=#e4f850]Marolini[/color][/b], una lata de [b][color=#e4f850]Coracola[/color][/b] y un paquete de cigarrillos [b][color=#e4f850]Malbardo[/color][/b]."
recordatorio_tia = "Quiero una caja de cereal [b][color=#e4f850]Zucarachas[/color][/b] y una caja de galletitas [b][color=#e4f850]Pepito[/color][/b]."
