[gd_resource type="Resource" script_class="DialogosDeCompradores" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/dominio/almacen/dialogos_de_compradores.gd" id="1"]

[resource]
script = ExtResource("1")
tin = PackedStringArray("Hola... ¿cómo andás?... Mmm, eee... me parece que hoy me toca cocinar huevos con arvejas... pará, pará... no. Hoy como en lo de mi vieja, ¿viste?... ¿No tenés una caja de [color=#e4f850]{16}[/color] y una [color=#e4f850]{14}[/color], de onda?...", "Gracias, che... uh, me olvidé, me quedé sin [color=#e4f850]{5}[/color].. ¿de casualidad no te sobra un puchito?...", "Es un chiste, hermano... dale, pasame una caja... ¿cuánto sería todo?...")
tia = PackedStringArray("Hola! Quiero un paquete de [color=#e4f850]{3}[/color] y un paquete de [color=#e4f850]{11}[/color], por favor.")
despedida_tin = PackedStringArray("[i](Pitada larga, el humo te tapa toda la cara, ni se da cuenta)[/i]\nGracias, che... sos lo más, en serio…")
despedida_tia = PackedStringArray("Gracias, tenía mucha hambre.", "Me presento: soy el Sr. T. ¡Mucho gusto! Soy investigador criminal. La última vez que estuve por acá ocurrió una tragedia. ¿No te enteraste lo que pasó con el empleado anterior?", "Con mi equipo de investigación seguimos analizando los movimientos de Enrique Peldaño, dueño de esta estación de servicio.", "En fin…. voy a disfrutar de las {3}. Te dejo mi número de teléfono, por si acaso. 11 5627-9132 ¡Anotalo! Hasta pronto!!")
