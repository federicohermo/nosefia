[gd_resource type="Resource" script_class="DialogosDeCompradores" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/dominio/almacen/dialogos_de_compradores.gd" id="1"]

[resource]
script = ExtResource("1")
tin = PackedStringArray("Hola... ¿cómo andás?... Mmm, eee... me parece que hoy me toca cocinar huevos con arvejas... pará, pará... no. Hoy como en lo de mi vieja, ¿viste?... ¿No tenés una caja de [color=#e4f850]{16}[/color] y una [color=#e4f850]{14}[/color], de onda?", "Gracias, che... uh, me olvidé, me quedé sin [color=#e4f850]{5}[/color]... ¿de casualidad no te sobra un puchito?", "Es un chiste, hermano... dale, pasame una caja... ¿cuánto sería todo?")
tia = PackedStringArray("……", "………….", "Dame un paquete de [color=#e4f850]{3}[/color]…", "Y unas [color=#e4f850]{11}[/color] también.")
despedida_tin = PackedStringArray("¡Gracias, che! Sos lo más, en serio.")
despedida_tia = PackedStringArray("Hasta luego….")
