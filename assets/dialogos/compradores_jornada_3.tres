[gd_resource type="Resource" script_class="DialogosDeCompradores" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/dominio/almacen/dialogos_de_compradores.gd" id="1"]

[resource]
script = ExtResource("1")
cami = PackedStringArray("¡Hola, amor! ¿Cómo estás?", "¡Ay! ¿Puede ser que seas un empleado nuevo? Te pregunto porque siempre paso y nunca te había visto. Y mirá que yo no me olvido una cara, ¿eh? Y tampoco me suena haberte visto por el pueblo.", "Adivino… te mudaste acá hace poco, ¿no? Es que tenés carita de otro lado. De citadino. Otra energía, ¿viste? Es que soy muy buena leyendo a las personas, por si no lo habías notado todavía.", "Vas a ver que acá la vibra es súper tranqui. Ya te vas a acostumbrar. Y la gente es toda divina. Como yo, ah. Qué se hacía jajajaja.", "¿Arrancaste hace mucho? Digo, porque como generalmente vengo más a la tardecita, me cruzo solo con la otra chica. ¿Cómo se llama?", "Eeeeeeeeh…. ¿Julia? No, no…. ¿Cómo era?", "No, era María. ¿O Mariana? Estoy segura de que es un nombre parecido…", "¡No, Yas! ¡Yasmín! ¡Nada que ver! Jajajajajaja. Bueno, a veces me confundo. No es fácil conocer a tanta gente.", "Bueno, te la hago corta porque me tengo que ir rajando. Dejé unos fideos en la hornalla y tengo miedo de que el gato se prenda fuego. ¿Me dás {producto1}, porfa? Solo eso.", "……….", "Ay, no, ¿sabés qué? Se me antojó también {producto2}. ¿Qué te puedo decir? Me gusta lo dulce jajajajaj.", "Listo, eso solo.", "¡Y también un juguito [color=#e4f850]{27}[/color]! Para bajar todo. Ah, se re empalagaba jajajaja.", "No, posta, solo esas tres cositas.")
despedida_cami = PackedStringArray("¡Gracias, bebé! ¡Que termines bien tu jornada! Otro día que tenga más tiempo me contás más sobre vos.", "¡Y yo te cuento todos los chismes que tenés que saber! ¿Dale? Sí, tenés cara de que te gusta el chisme. Yo sabía que eras de los míos.", "¡Nos vemos! Besitos.")
tin = PackedStringArray("¡Hola, wacho! ¿Cómo va todo por acá ?", "Mi mamá me cago a pedos hoy porque me pidió que le comprara algo y me olvidé. Una cagada, loco, pero bueno…", "Me dijo que me iba a dar una chance más ¿viste? {producto1} necesito. Sino me mata...", "Eeee.. entonces {producto1} para ella y para mí te pido {producto2} y {producto3}.")
despedida_tin = PackedStringArray("Gracias amigou, hasta la próxima.")
