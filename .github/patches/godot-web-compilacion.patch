+// Asks for the program and returns without reading any status: a status query blocks
+// until the browser finishes the link. Transform feedback is not set up, so this only
+// serves shaders without feedback.
+void ShaderGLES3::_queue_specialization(Version *p_version, int p_variant, uint64_t p_specialization) {
+	Version::Specialization spec;
+	spec.id = glCreateProgram();
+	spec.vert_id = glCreateShader(GL_VERTEX_SHADER);
+	spec.frag_id = glCreateShader(GL_FRAGMENT_SHADER);
+
+	const GLuint stage_ids[STAGE_TYPE_MAX] = { spec.vert_id, spec.frag_id };
+	for (int i = 0; i < STAGE_TYPE_MAX; i++) {
+		StringBuilder builder;
+		_build_variant_code(builder, p_variant, p_version, StageType(i), p_specialization);
+		CharString cs = builder.as_string().utf8();
+		const char *cstr = cs.ptr();
+		GLint cstr_len = cs.length();
+		glShaderSource(stage_ids[i], 1, &cstr, &cstr_len);
+		glCompileShader(stage_ids[i]);
+	}
+
+	glAttachShader(spec.id, spec.frag_id);
+	glAttachShader(spec.id, spec.vert_id);
+	glLinkProgram(spec.id);
+
+	spec.build_queued = true;
+	p_version->variants[p_variant].insert(p_specialization, spec);
+
+	QueuedSpecialization queued;
+	queued.version = p_version;
+	queued.variant = p_variant;
+	queued.specialization = p_specialization;
+	link_queue.push_back(queued);
+	_publish_link_queue();
+}
+
+void ShaderGLES3::poll_link_queue() {
+	if (!parallel_link_checked) {
+		parallel_link_checked = true;
+		parallel_link = emscripten_webgl_enable_extension(emscripten_webgl_get_current_context(), "KHR_parallel_shader_compile");
+		if (parallel_link) {
+			_publish_link_queue();
+		}
+	}
+
+	const uint32_t queued_count = link_queue.size();
+	for (uint32_t i = 0; i < link_queue.size();) {
+		const QueuedSpecialization queued = link_queue[i];
+		Version::Specialization *spec = queued.version->variants[queued.variant].getptr(queued.specialization);
+
+		// A lost context answers true, so the queue always empties.
+		GLint status = GL_FALSE;
+		glGetProgramiv(spec->id, _GL_COMPLETION_STATUS_KHR, &status);
+		if (status == GL_FALSE) {
+			i++;
+			continue;
+		}
+
+		glGetProgramiv(spec->id, GL_LINK_STATUS, &status);
+		if (status == GL_FALSE) {
+			// Compile again on the spot: that path reports the error with its source.
+			glDeleteShader(spec->vert_id);
+			glDeleteShader(spec->frag_id);
+			glDeleteProgram(spec->id);
+			*spec = Version::Specialization();
+			_compile_specialization(*spec, queued.variant, queued.version, queued.specialization);
+		} else {
+			_get_uniform_locations(*spec, queued.version);
+			spec->ok = true;
+			spec->build_queued = false;
+		}
+		link_queue.remove_at_unordered(i);
+	}
+
+	if (link_queue.size() != queued_count) {
+		_publish_link_queue();
+	}
+}
