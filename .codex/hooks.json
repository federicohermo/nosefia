{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/scripts/gate_de_rama.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/scripts/gate_de_worktrees.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Grep|Glob|Read|Bash|PowerShell|mcp__nosefia-index__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/scripts/recordatorio_del_indice.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/scripts/formatear_al_editar.py",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/scripts/recordatorio_del_indice.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
